{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "app/_layout.tsx",
    "app/index.tsx",
    "app/+not-found.tsx",
    "components/max/**/*.tsx",
    "providers/MaxProvider.tsx",
    "services/max/**/*.ts",
    "tests/**/*.ts",
    "types/vendor.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
